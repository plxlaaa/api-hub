# ============================================================
#  API Hub 环境变量示例
#  用法：cp .env.example .env 后按需修改
#  .env 已被 .gitignore 排除，不会误提交
# ============================================================

# ---- 基础 ----
# 主机侧映射端口（容器内固定 3000）
PORT=3000
# 时区：影响日志时间戳与「今日」统计口径
TZ=Asia/Shanghai

# ---- Docker ----
# 设为 1 走 npmmirror 国内镜像（等价于安装脚本的 --cn）
CN_MIRROR=0

# ---- 日志（结构化日志）----
# debug | info | warn | error | silent
# 排障时调 debug；只想看错误可调 warn
LOG_LEVEL=info
# json = 采集给 journald/Loki/ELK；text = 终端直接阅读
LOG_FORMAT=json
# 设为 1 彻底静默日志（仅测试用）
# LOG_SILENT=0
# 设为 query 会打印 SQL，排查慢查询时开
# PRISMA_LOG=query

# ---- 运行时（仅手动部署 / 容器覆盖时需要）----
# 监听地址。只由本机反代对外时务必保持 127.0.0.1，避免直接暴露到公网
HOSTNAME=127.0.0.1
NODE_ENV=production

# ---- 安全 ----
# 私有仓库拉源码用的 GitHub PAT（勾选 repo 即可）。
# 仅供安装脚本使用，切勿提交进仓库。
# GITHUB_TOKEN=ghp_xxx