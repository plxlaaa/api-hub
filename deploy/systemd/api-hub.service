# ============================================================
#  API Hub systemd 服务单元
#  安装：
#    sudo cp deploy/systemd/api-hub.service /etc/systemd/system/
#    sudo systemctl daemon-reload
#    sudo systemctl enable --now api-hub
#
#  脚本安装（install-api-hub.sh）会自动生成等价配置，此文件供手动部署使用。
# ============================================================

[Unit]
Description=API Hub · 个人公益站 API 聚合网关
Documentation=https://github.com/plxlaaa/api-hub
After=network-online.target
Wants=network-online.target

# 反复崩溃时不要疯狂重启：10 分钟内超过 5 次即停止重试并标记失败，等人工介入。
# ⚠️ 这两个指令必须放在 [Unit] 段：放在 [Service] 段会被 systemd 静默忽略
# （旧版本 unit 里曾写错位置，导致崩溃时无限重启刷满日志）。
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=api-hub
Group=api-hub
WorkingDirectory=/opt/api-hub

# 部署相关可变项集中放在 env 文件，改端口/时区/日志级别不必再改本单元 + daemon-reload。
# 文件不存在时 systemd 会直接启动失败，故默认注释掉；需要时按下方说明创建：
#   sudo cp deploy/env/api-hub.env.example /etc/api-hub/api-hub.env
#   sudo chown api-hub:api-hub /etc/api-hub/api-hub.env && sudo chmod 600 /etc/api-hub/api-hub.env
#   # 然后把下面这行取消注释
# EnvironmentFile=/etc/api-hub/api-hub.env

Environment=NODE_ENV=production
Environment=PORT=3000
# 只监听本机，由 Caddy/nginx 反代对外。只在本机直连时才改成 0.0.0.0
Environment=HOSTNAME=127.0.0.1
Environment=TZ=Asia/Shanghai
# 日志级别：debug | info | warn | error | silent
Environment=LOG_LEVEL=info
# 日志格式：json（采集） | text（人读）
Environment=LOG_FORMAT=json

# systemd 对可执行路径有白名单校验，命令必须用绝对路径
ExecStart=/usr/bin/node /opt/api-hub/.next/standalone/server.js

# 优雅停机：先停止接收新请求，等存量请求跑完（长流式回答需要时间）
KillSignal=SIGTERM
TimeoutStopSec=45
Restart=always
RestartSec=5
# 重启节流参数见上方 [Unit] 段的 StartLimitIntervalSec / StartLimitBurst

# ---- 安全加固 ----
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
# 需要写db/ 目录，故放开 ReadWritePaths
ReadWritePaths=/opt/api-hub/db
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

# 日志走 journald，由 journald 自带轮转管理（/etc/systemd/journald.conf）。
# 若改为写文件（nohup 降级模式 /容器 bind mount），用 deploy/logrotate/api-hub 轮转。
StandardOutput=journal
StandardError=journal
SyslogIdentifier=api-hub

# 打开调试日志时用这一行定位单次请求的全链路（客户端响应头 X-Request-Id 与之一致）：
#   journalctl -u api-hub -f | grep -F '<requestId>'
# 不需要时保持注释，避免高频请求把磁盘刷满。

[Install]
WantedBy=multi-user.target