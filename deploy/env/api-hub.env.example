# ============================================================
#  API Hub 环境变量样例（systemd 用 EnvironmentFile 加载）
#
#  用途：把部署相关的可变项从 systemd 单元里挪出来，
#  改端口/时区/日志级别不必再编辑 unit 文件 + daemon-reload。
#
#  安装：
#    sudo cp deploy/env/api-hub.env.example /etc/api-hub/api-hub.env
#    sudo chown api-hub:api-hub /etc/api-hub/api-hub.env
#    sudo chmod 600 /etc/api-hub/api-hub.env
#    # 然后在 api-hub.service 的 [Service] 段加一行：
#    #   EnvironmentFile=/etc/api-hub/api-hub.env
#    sudo systemctl daemon-reload && sudo systemctl restart api-hub
#
#  ⚠️ 此文件可能被systemd 以明文读取，**不要往里写任何密钥**：
#     上游 Key 存在 SQLite，网关统一 Key 在管理台创建，均不需要也不应该写进环境变量。
# ============================================================

# 监听端口：改这里后，反代与防火墙也要同步改
PORT=3000

# 只监听本机，由 Caddy/nginx 反代对外。
# 仅在本机直连（不走反代）时才改成 0.0.0.0，否则等于把管理面板直接暴露到公网。
HOSTNAME=127.0.0.1

# 时区：影响日志时间戳与「今日」统计口径
TZ=Asia/Shanghai

# 日志级别：debug | info | warn | error | silent
# 排障时临时调成 debug，定位完记得改回 info
LOG_LEVEL=info

# 日志格式：json（采集给 Loki/ELK）| text（终端直接阅读，更适合人工排障）
LOG_FORMAT=json

# Node 运行时
NODE_ENV=production